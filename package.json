{
  "name": "@kanasero/ai-wrapper-repo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "publish:once": "npm -w @kanasero/ai-wrapper publish --access public",
    "playground": "npm -w ai-wrapper-playground run dev",
    "build:lib": "npm -w @kanasero/ai-wrapper run build",
    "publish": "npm -w @kanasero/ai-wrapper version patch && npm -w @kanasero/ai-wrapper publish"
  }
}
